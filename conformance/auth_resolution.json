  "description": "Credential-resolution chain fixtures (spec/auth.md AUTH-1) exercised through each implementation's explain_auth equivalent (AUTH-7). Language-neutral: 'steps' name source kinds, not display strings. The sentinel below is planted as every secret value; no rendered report may contain it (AUTH-5).",
  "sentinel": "SECRET-SENTINEL-DO-NOT-PRINT",
  "cases": [
    {
      "id": "env-selected",
      "provider": "anthropic",
      "env": { "ANTHROPIC_API_KEY": "SECRET-SENTINEL-DO-NOT-PRINT" },
      "api_keys_providers": [],
      "expect": {
        "configured": true,
        "steps": [
          { "kind": "api_keys", "state": "absent" },
          { "kind": "env:ANTHROPIC_API_KEY", "state": "selected" }
        ]
      }
    },
    {
      "id": "api-keys-shadows-env",
      "provider": "openai",
      "env": { "OPENAI_API_KEY": "SECRET-SENTINEL-DO-NOT-PRINT" },
      "api_keys_providers": ["openai"],
      "expect": {
        "configured": true,
        "steps": [
          { "kind": "api_keys", "state": "selected" },
          { "kind": "env:OPENAI_API_KEY", "state": "shadowed" }
        ]
      }
    },
    {
      "id": "nothing-configured",
      "provider": "groq",
      "env": {},
      "api_keys_providers": [],
      "expect": {
        "configured": false,
        "steps": [
          { "kind": "api_keys", "state": "absent" },
          { "kind": "env:GROQ_API_KEY", "state": "absent" }
        ]
      }
    },
    {
      "id": "local-server-placeholder",
      "provider": "ollama",
      "env": {},
      "api_keys_providers": [],
      "expect": {
        "configured": true,
        "steps": [
          { "kind": "api_keys", "state": "absent" },
          { "kind": "placeholder", "state": "selected" }
        ]
      }
    },
    {
      "id": "oauth-fresh",
      "provider": "claude-code",
      "borrowed_file": { "state": "fresh" },
      "expect": {
        "configured": true,
        "steps": [{ "kind": "oauth-file", "state": "selected" }]
      }
    },
    {
      "id": "oauth-missing",
      "provider": "claude-code",
      "borrowed_file": { "state": "missing" },
      "expect": {
        "configured": false,
        "steps": [{ "kind": "oauth-file", "state": "absent" }]
      }
    },
    {
      "id": "oauth-expired-with-refresh-token",
      "provider": "claude-code",
      "borrowed_file": { "state": "expired-with-refresh" },
      "expect": {
        "configured": true,
        "steps": [{ "kind": "oauth-file", "state": "selected" }]
      }
    },
    {
      "id": "oauth-expired-no-refresh-token",
      "provider": "claude-code",
      "borrowed_file": { "state": "expired-no-refresh" },
      "expect": {
        "configured": false,
        "steps": [{ "kind": "oauth-file", "state": "absent" }]
      }
    },
    {
      "id": "oauth-never-falls-back-to-env",
      "provider": "claude-code",
      "env": { "ANTHROPIC_API_KEY": "SECRET-SENTINEL-DO-NOT-PRINT" },
      "borrowed_file": { "state": "missing" },
      "expect": {
        "configured": false,
        "steps": [{ "kind": "oauth-file", "state": "absent" }]
